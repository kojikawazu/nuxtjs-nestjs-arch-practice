# ───────────── MySQL ─────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=taskdb
MYSQL_USER=taskuser
MYSQL_PASSWORD=taskpassword
MYSQL_PORT=3306

# ───────────── Backend (NestJS) ─────────────
BACKEND_PORT=3001
# TypeORM (本番用 DB)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=taskuser
DB_PASSWORD=taskpassword
DB_DATABASE=taskdb

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 画像アップロード（タスクの添付画像）
# 保存先ディレクトリ。compose では backend コンテナにこのパスへ volume をマウントする。
UPLOAD_DIR=uploads
# 1ファイルの最大バイト数（既定 2MB）
MAX_UPLOAD_BYTES=2097152

# ───────────── Frontend (Nuxt) ─────────────
FRONTEND_PORT=3000
# Nitro サーバから見た backend のベース URL
NUXT_API_BASE_URL=http://localhost:3001

# ───────────── Test DB (backend e2e 用) ─────────────
TEST_DB_HOST=localhost
TEST_DB_PORT=3307
TEST_DB_USERNAME=taskuser
TEST_DB_PASSWORD=taskpassword
TEST_DB_DATABASE=taskdb_test
