# ───────────── MySQL ─────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=taskdb
MYSQL_USER=taskuser
MYSQL_PASSWORD=taskpassword
MYSQL_PORT=3306

# ───────────── Backend (NestJS) ─────────────
BACKEND_PORT=3001
# DB の接続先を切替: mysql（本番/compose）/ better-sqlite3（ローカル・Docker 不要）
# Docker なしで最速起動したい場合は次の2行を使う:
#   DB_TYPE=better-sqlite3
#   DB_DATABASE=:memory:
DB_TYPE=mysql
# TypeORM (本番用 DB。DB_TYPE=mysql のとき使用)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=taskuser
DB_PASSWORD=taskpassword
DB_DATABASE=taskdb

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 画像アップロード（タスクの添付画像）
# 保存先ディレクトリ。compose では backend コンテナにこのパスへ volume をマウントする。
UPLOAD_DIR=uploads
# 1ファイルの最大バイト数（既定 2MB）
MAX_UPLOAD_BYTES=2097152

# ───────────── Frontend (Nuxt) ─────────────
FRONTEND_PORT=3000
# Nitro サーバから見た backend のベース URL
NUXT_API_BASE_URL=http://localhost:3001
# 添付画像の上限バイト数。backend の MAX_UPLOAD_BYTES と同じ値にする（フォームの事前チェック用）
NUXT_PUBLIC_MAX_UPLOAD_BYTES=2097152

# ───────────── Test DB (backend e2e 用) ─────────────
TEST_DB_HOST=localhost
TEST_DB_PORT=3307
TEST_DB_USERNAME=taskuser
TEST_DB_PASSWORD=taskpassword
TEST_DB_DATABASE=taskdb_test
