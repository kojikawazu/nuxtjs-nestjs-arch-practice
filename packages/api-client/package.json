{
  "name": "@app/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI から生成した型 + openapi-fetch ベースの型安全クライアント",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../api-spec/tsp-output/openapi.yaml -o ./src/generated/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  }
}
