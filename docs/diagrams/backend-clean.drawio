        <mxCell id="clean-tasks-c58" value="" style="rounded=1;html=1;fillColor=#f1f8ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1394" y="174" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c59" value="application（ユースケース）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="170" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c60" value="" style="rounded=1;html=1;fillColor=#fff8e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1394" y="200" width="26" height="16" as="geometry" /></mxCell>
