<mxfile host="drawio" agent="Claude Code">
  <diagram id="clean-tasks" name="1. clean: tasks の依存方向">
    <mxGraphModel dx="1720" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="clean-tasks-c1" value='&lt;b&gt;backend-clean — tasks の依存方向（クリーンアーキテクチャ）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;矢印（依存＝import）はすべて下向き＝内側へ。外側にいる infrastructure も application の &lt;b&gt;ports/&lt;/b&gt; に向かう（依存性逆転）。パスは apps/backend-clean/src/api/tasks/ 起点&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="55" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c2" value="&lt;b&gt;presentation/&lt;/b&gt;　外側：HTTP の入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="600" height="330" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c3" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;dto/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;createTaskSchema / updateTaskSchema&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;zod・.strict()・satisfies z.ZodType&amp;lt;契約型&amp;gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="275" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c4" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;guards/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JwtAuthGuard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;auth の Guard を re-export（未認証 401）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="345" y="120" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c5" value='&lt;font style="font-size: 10px; color: #777777;"&gt;&lt;b&gt;shared/presentation/pipes/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ZodValidationPipe&lt;/b&gt;（422）&lt;br&gt;&lt;b&gt;ImageFilePipe&lt;/b&gt;（413 / 422）' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="198" width="275" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c6" value='&lt;font style="font-size: 10px; color: #777777;"&gt;&lt;b&gt;shared/presentation/filters/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AllExceptionsFilter&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;DomainError.kind → 404/403/422/409/401 → ApiError&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="345" y="198" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c7" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;controllers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TasksController&lt;/b&gt;　@UseGuards(JwtAuthGuard)&lt;br&gt;&lt;font style="font-size: 10px;"&gt;GET・POST /tasks　／　GET・PATCH・DELETE /tasks/:id　／　POST・DELETE /tasks/:id/image&lt;br&gt;契約型を inputs/ で Command に直し、書き込みは usecases/・読み取りは query-services/ へ委譲&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="565" height="125" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c8" value="&lt;b&gt;infrastructure/&lt;/b&gt;　外側：TypeORM・ファイル I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="620" height="330" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c9" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;entities/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TaskOrmEntity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;extends AuditableOrmEntity&lt;br&gt;監査列は TypeORM が自動設定&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="120" width="185" height="105" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c10" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;mappers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ormToDomain&lt;br&gt;domainToOrm&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ORM ↔ domain Task&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="180" height="105" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c11" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;外部 I/O&lt;/font&gt;' style="rounded=1;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="205" height="105" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c12" value="MySQL&lt;br&gt;/ SQLite" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="140" width="90" height="78" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c13" value="uploads/&lt;br&gt;（FS）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="140" width="85" height="78" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c14" value="repositories/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="735" y="235" width="375" height="175" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c15" value='&lt;b&gt;TypeOrmTaskRepository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;書き込み側&lt;br&gt;ORM ↔ domain Task&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="745" y="260" width="175" height="140" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c16" value='&lt;b&gt;TypeOrmTaskQuery&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;読み取り側&lt;br&gt;ORM 行 → 契約 Task&lt;br&gt;（1 段の直射影）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="170" height="140" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c17" value="services/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1120" y="235" width="205" height="175" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c18" value='&lt;b&gt;LocalImageStorage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;MIME 判定・保存・削除&lt;br&gt;（不正 MIME は&lt;br&gt;UnsupportedImageTypeError）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1130" y="260" width="185" height="140" as="geometry" /></mxCell>
