        <mxCell id="clean-tasks-c62" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1394" y="226" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c63" value="shared/（feature 非依存の共通基盤）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="222" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c64" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1394" y="252" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c65" value="Port（«interface» + DI トークン）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="248" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c66" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="294" as="sourcePoint" /><mxPoint x="1424" y="294" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="clean-tasks-c67" value="依存（import / 呼び出し）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="282" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c68" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="320" as="sourcePoint" /><mxPoint x="1424" y="320" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="clean-tasks-c69" value="implements（契約を実装）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="308" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c70" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;startArrow=open;endArrow=open;dashed=1;strokeWidth=2;strokeColor=#d6336c;fontColor=#d6336c;fontSize=10;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="346" as="sourcePoint" /><mxPoint x="1424" y="346" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="clean-tasks-c71" value="ESLint で禁止される方向" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="334" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c72" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1392" y="372" as="sourcePoint" /><mxPoint x="1424" y="372" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="clean-tasks-c73" value="合成ルートが DI で束ねる" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1428" y="360" width="240" height="24" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c74" value='&lt;b&gt;ESLint が禁止する import&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;（@typescript-eslint/no-restricted-imports）&lt;/font&gt;&lt;br&gt;&lt;br&gt;domain → application / infrastructure / presentation&lt;br&gt;application → infrastructure / presentation&lt;br&gt;presentation → infrastructure&lt;br&gt;infrastructure → presentation&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;違反は pnpm lint / CI で落ちる。禁止方向に import したくなったら Port を足す合図。&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1380" y="410" width="300" height="200" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c75" value='&lt;b&gt;tasks.module.ts&lt;/b&gt;（合成ルート）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;feature 直下＝層の外なので ESLint の対象外。実装クラスを知るのはここだけ&lt;/font&gt;&lt;br&gt;&lt;br&gt;TASK_REPOSITORY → TypeOrmTaskRepository&lt;br&gt;TASK_QUERY → TypeOrmTaskQuery&lt;br&gt;IMAGE_STORAGE → LocalImageStorage&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;MulterModule: limits.fileSize = MAX_UPLOAD_BYTES（メモリに載る前に 413）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1380" y="630" width="300" height="230" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c76" value="DI で束ねる" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-tasks-c75" target="clean-tasks-c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-tasks-c77" value="&lt;b&gt;layered との差&lt;/b&gt;&lt;br&gt;&lt;br&gt;layered の UseCase は TypeORM Repository を&lt;b&gt;直接&lt;/b&gt; import する（Port なし）。&lt;br&gt;&lt;br&gt;clean は application が interface だけを所有し、実装は外側から差し込まれる。この差が 3 版比較の本質。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="880" width="300" height="195" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ddd-tactical" name="2. DDD 戦術パターン">
    <mxGraphModel dx="1720" dy="1340" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ddd-tactical-c1" value='&lt;b&gt;DDD の戦術パターン（backend-clean）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Entity / Value Object / Domain Service / Repository、Aggregate / Factory / Domain Event（未採用）と、業務エラー・検証の責務分担。onion も構成要素とクラス名は同じで、置き場所だけが異なる（5 ページ目）&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="55" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c2" value="&lt;b&gt;Task 集約&lt;/b&gt;（集約ルート＝Task）　api/tasks/domain/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf6;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="430" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c3" value="«Entity»  Task" style="swimlane;fontStyle=1;align=center;startSize=30;html=1;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;fontSize=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="340" height="370" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c4" value='- id: string　&lt;i&gt;← 同一性&lt;/i&gt;&lt;br&gt;- userId: string&lt;br&gt;- title / description&lt;br&gt;- status: todo | in_progress | done&lt;br&gt;- period: DateRange&lt;br&gt;- url / imageUrl&lt;br&gt;- createdAt / updatedAt&lt;hr&gt;+ static draft(input): NewTask　&lt;i&gt;← Factory（新規）&lt;/i&gt;&lt;br&gt;+ static fromState(state): Task　&lt;i&gt;← Factory（復元）&lt;/i&gt;&lt;br&gt;+ assertOwnedBy(userId)&lt;br&gt;+ applyUpdate(patch)&lt;br&gt;+ attachImage(path): 旧パス&lt;br&gt;+ detachImage(): 旧パス&lt;br&gt;+ toState(): TaskState&lt;hr&gt;&lt;font style="font-size: 10px;"&gt;private constructor。生成は draft（新規）/ fromState（復元）の 2 経路だけ&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="ddd-tactical-c3"><mxGeometry x="0" y="30" width="340" height="340" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c5" value="«Value Object»  DateRange" style="swimlane;fontStyle=1;align=center;startSize=30;html=1;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;fontSize=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="230" height="190" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c6" value="- readonly start: Date&lt;br&gt;- readonly end: Date | null&lt;hr&gt;- private constructor&lt;br&gt;+ static of(start, end)　&lt;i&gt;← Factory&lt;/i&gt;&lt;br&gt;+ withStart(start)&lt;br&gt;+ withEnd(end)&lt;br&gt;+ equals(other)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="ddd-tactical-c5"><mxGeometry x="0" y="30" width="230" height="160" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c7" value="period" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;strokeColor=#9c6a00;fontColor=#9c6a00;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c3" target="ddd-tactical-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c8" value="&lt;b&gt;不正な DateRange は作れない&lt;/b&gt;&lt;br&gt;of() で 開始 ≤ 終了 を検証（違反は InvalidDateRangeError）。Date は防御的にコピーして保持・返却し、外から書き換えられない。&lt;br&gt;applyUpdate は期間を先に組み立てるので、不正な更新で state が半端に壊れない。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="345" width="230" height="145" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c9" value="&lt;b&gt;User 集約&lt;/b&gt;　api/users/domain/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf6;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="640" height="230" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c10" value="«Entity»  User" style="swimlane;fontStyle=1;align=center;startSize=30;html=1;whiteSpace=wrap;fillColor=#fff8e6;strokeColor=#d6b656;fontSize=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="340" height="170" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c11" value="- id: string&lt;br&gt;- email / displayName&lt;br&gt;- passwordHash　&lt;i&gt;← 照合用。契約には出さない&lt;/i&gt;&lt;br&gt;- createdAt / updatedAt&lt;hr&gt;+ static fromState(state): User&lt;br&gt;+ toState(): UserState" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="ddd-tactical-c10"><mxGeometry x="0" y="30" width="340" height="140" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c12" value="&lt;b&gt;集約をまたぐ参照は ID で&lt;/b&gt;&lt;br&gt;Task は User をオブジェクトで持たず &lt;b&gt;userId&lt;/b&gt; だけを持つ。所有チェックは userId の比較（assertOwnedBy）で済み、Task のロードに User を巻き込まない。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="240" height="170" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c13" value="userId で ID 参照" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;strokeColor=#9c6a00;fontColor=#9c6a00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c3" target="ddd-tactical-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c14" value="«interface»  TaskRepository　（application/ports/）" style="swimlane;fontStyle=1;align=center;startSize=30;html=1;whiteSpace=wrap;fillColor=#f1f8ee;strokeColor=#82b366;fontSize=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="450" height="205" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c15" value='+ findById(id): Task | null&lt;br&gt;+ listByUserId(userId): Task[]&lt;br&gt;+ create(input: NewTask): Task&lt;br&gt;+ update(task: Task): Task&lt;br&gt;+ deleteById(id): void&lt;hr&gt;&lt;font style="font-size: 10px;"&gt;集約ルート単位で出し入れする（DateRange だけを保存する口は無い）。実装は TypeOrmTaskRepository。&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="ddd-tactical-c14"><mxGeometry x="0" y="30" width="450" height="175" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c16" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.17;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c14" target="ddd-tactical-c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c17" value="«Domain Service»  TaskAccessService　（clean: application/services/）" style="swimlane;fontStyle=1;align=center;startSize=30;html=1;whiteSpace=wrap;fillColor=#f1f8ee;strokeColor=#82b366;fontSize=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="325" width="450" height="205" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c18" value='+ loadOwned(userId, id): Task&lt;br&gt;　1. TaskRepository.findById(id) → 無ければ &lt;b&gt;TaskNotFoundError&lt;/b&gt;（404）&lt;br&gt;　2. task.assertOwnedBy(userId) → &lt;b&gt;TaskAccessDeniedError&lt;/b&gt;（403）&lt;hr&gt;&lt;font style="font-size: 10px;"&gt;Task 単体では『取得』ができない（Port が要る）＝ Entity に自然な置き場所が無いので Domain Service。UpdateTaskValidator・Delete / SetImage / RemoveImage の各 UseCase が再利用する。契約を application が持つ clean では application 側、domain が持つ onion では domain/services/。&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;" vertex="1" parent="ddd-tactical-c17"><mxGeometry x="0" y="30" width="450" height="175" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c19" value="findById" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c17" target="ddd-tactical-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c20" value="assertOwnedBy" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.97;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c17" target="ddd-tactical-c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c21" value='&lt;b&gt;domain の要素をどう選ぶか&lt;/b&gt;（判定軸は同一性と置き場所）&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 11px; border-collapse: collapse;" border="1" cellpadding="4"&gt;&lt;tr&gt;&lt;th&gt;要素&lt;/th&gt;&lt;th&gt;判定基準&lt;/th&gt;&lt;th&gt;例&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Entity&lt;/td&gt;&lt;td&gt;id を持ち、状態が変わる&lt;/td&gt;&lt;td&gt;Task / User&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Value Object&lt;/td&gt;&lt;td&gt;属性だけで等価・不変&lt;/td&gt;&lt;td&gt;DateRange&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Domain Service&lt;/td&gt;&lt;td&gt;Entity にも VO にも置き場所が無い操作&lt;/td&gt;&lt;td&gt;TaskAccessService&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;『VO 以外は Domain Service』ではない。それだと Entity まで振る舞いを失い貧血ドメインになる。Domain Service は最後の手段で、既定の受け皿ではない。&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="450" height="230" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c22" value="&lt;b&gt;業務エラー&lt;/b&gt;　DomainError（HTTP を知らない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="470" height="430" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c23" value='«abstract»&lt;br&gt;&lt;b&gt;DomainError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;kind: DomainErrorKind　fields?: string[]&lt;br&gt;shared/domain/errors/&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c24" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;tasks/domain/errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TaskNotFoundError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;not_found&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TaskAccessDeniedError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;forbidden&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;InvalidDateRangeError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;invalid・fields: [endDate]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;UnsupportedImageTypeError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;invalid・fields: [file]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1222" y="255" width="220" height="260" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c25" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;auth・users/domain/errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;EmailAlreadyRegisteredError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;conflict（users）&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;InvalidCredentialsError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;unauthorized（auth）&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;InvalidRefreshTokenError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;unauthorized（auth）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1452" y="255" width="216" height="260" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c26" value="extends" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c24" target="ddd-tactical-c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c27" value="extends" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c25" target="ddd-tactical-c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c28" value='&lt;b&gt;AllExceptionsFilter&lt;/b&gt;（shared/presentation/filters/）が kind を HTTP に翻訳&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 11px; border-collapse: collapse;" border="1" cellpadding="4"&gt;&lt;tr&gt;&lt;th&gt;kind&lt;/th&gt;&lt;th&gt;HTTP&lt;/th&gt;&lt;th&gt;例&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;not_found&lt;/td&gt;&lt;td&gt;404&lt;/td&gt;&lt;td&gt;他人のタスクは 403、無いものだけ 404&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;forbidden&lt;/td&gt;&lt;td&gt;403&lt;/td&gt;&lt;td&gt;非所有&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;invalid&lt;/td&gt;&lt;td&gt;422&lt;/td&gt;&lt;td&gt;fields → ApiError.errors&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;conflict&lt;/td&gt;&lt;td&gt;409&lt;/td&gt;&lt;td&gt;メール重複&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;unauthorized&lt;/td&gt;&lt;td&gt;401&lt;/td&gt;&lt;td&gt;認証情報・refresh 不正&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ステータスを決めるのは presentation の 1 か所だけ。ドメインは HTTP を知らない。&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1210" y="560" width="470" height="230" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c29" value="throw → catch" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;strokeColor=#d6336c;fontColor=#d6336c;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c24" target="ddd-tactical-c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c30" value="&lt;b&gt;そのほかの戦術パターン&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1640" height="180" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c31" value='&lt;b&gt;Aggregate（集約）&lt;/b&gt;　専用のフォルダ・基底クラスは置かず、構造と使い方で表す&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;・出し入れは集約ルート単位（TaskRepository は Task を返す。DateRange だけの口は無い）&lt;br&gt;・変更は必ずルート経由（期間の変更は task.applyUpdate）&lt;br&gt;・別の集約は id で参照（Task.userId。User オブジェクトは持たない）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="855" width="520" height="130" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c32" value='&lt;b&gt;Factory&lt;/b&gt;　factories/ は置かず、Entity / VO の static メソッドに内蔵&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;・Task.draft（新規：既定値＋期間検証）← CreateTaskValidator&lt;br&gt;・Task.fromState / User.fromState（復元）← infrastructure の mapper&lt;br&gt;・DateRange.of（生成時に検証。復元時も通るので、壊れた行はドメインに入らない）&lt;br&gt;constructor は private＝生成の入口はこれだけ。生成に外部情報が要るようになったら TaskFactory に切り出す&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="855" width="520" height="130" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c33" value='&lt;b&gt;Domain Event&lt;/b&gt;　&lt;i&gt;未採用&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;『起きたことに別の処理が反応する』要件がまだ無いため置かない。&lt;br&gt;導入候補：TaskCompleted（done で通知）・UserRegistered（ウェルカムメール）&lt;br&gt;近い例：SetTaskImageUseCase は旧画像の削除を同じ処理の中で直接呼んでいる（今の規模ではこれで足りる）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1140" y="855" width="520" height="130" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c34" value="&lt;b&gt;検証の責務分担&lt;/b&gt;　— Laravel の FormRequest 1 つが 3 か所に分解されている（forms/ は作らない）。①→②→③ がリクエストの実行順" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1640" height="305" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c35" value='&lt;b&gt;① 認可&lt;/b&gt;（FormRequest の authorize() 相当）&lt;br&gt;&lt;br&gt;presentation/guards/ の &lt;b&gt;JwtAuthGuard&lt;/b&gt; … 未認証 → 401&lt;br&gt;＋ &lt;b&gt;TaskAccessService&lt;/b&gt; … 不存在 → 404 / 非所有 → 403&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Guard は Pipe より先に走るので、未認証のリクエストは形式検証まで届かない&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="520" height="175" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c36" value='&lt;b&gt;② 形式検証&lt;/b&gt;（rules() の required|max 相当）＝ transport の関心&lt;br&gt;&lt;br&gt;presentation/dto/ の &lt;b&gt;zod スキーマ&lt;/b&gt; ＋ ルート単位の &lt;b&gt;ZodValidationPipe&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;必須・型・title 1〜120 文字・status 列挙・RFC 3339 日付・http/https URL・password 72 バイト（UTF-8）&lt;/font&gt;&lt;br&gt;→ 422 ＋ ApiError.errors（field 別の理由）' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="1060" width="520" height="175" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c37" value='&lt;b&gt;③ 業務ルール検証&lt;/b&gt;（unique: 相当）＝ ドメインの関心&lt;br&gt;&lt;br&gt;application/validators/（&lt;b&gt;唯一の検証実体&lt;/b&gt;）＋ Entity / VO の不変条件&lt;br&gt;&lt;font style="font-size: 10px;"&gt;開始 ≤ 終了（DateRange）・メール重複（RegisterValidator）&lt;/font&gt;&lt;br&gt;→ DomainError（invalid 422 / conflict 409）' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1140" y="1060" width="520" height="175" as="geometry" /></mxCell>
        <mxCell id="ddd-tactical-c38" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c35" target="ddd-tactical-c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c39" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddd-tactical-c36" target="ddd-tactical-c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ddd-tactical-c40" value="迷ったら『&lt;b&gt;HTTP でなくても成り立つ制約か&lt;/b&gt;』で切り分ける。成り立つ → ③（Validator / Entity / VO）、HTTP の入口でしか意味がない → ②（zod）。&lt;br&gt;VO が担うのは zod では表しにくい&lt;b&gt;フィールド間の関係&lt;/b&gt;だけで、単一フィールドの長さ・形式は zod に残す（同じルールの入口を 2 つにしない）。保存せず検証だけ行う DryRun エンドポイントも置かない。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1245" width="1600" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="clean-auth" name="3. clean: auth / users">
    <mxGraphModel dx="1720" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="clean-auth-c1" value='&lt;b&gt;backend-clean — auth / users（外部 I/O をすべて Port 化）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;ユースケースは bcrypt・JWT・TypeORM を知らない。users は HTTP の入口を持たず、auth が UsersModule 経由で USER_REPOSITORY を使う。パスは apps/backend-clean/src/api/ 起点&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="55" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c2" value="&lt;b&gt;presentation/&lt;/b&gt;（auth）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="600" height="330" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c3" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;auth/presentation/dto/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;registerSchema / loginSchema / refreshSchema&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;password は UTF-8 で 72 バイト以内（bcrypt の静かな切り捨て対策。登録とログインの両方）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="275" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c4" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;auth/presentation/strategies/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JwtAccessStrategy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;access JWT を検証 → AuthenticatedUser&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="345" y="120" width="280" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c5" value="&lt;font style=&quot;font-size: 10px; color: #6c8ebf;&quot;&gt;&lt;b&gt;auth/presentation/guards/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JwtAuthGuard&lt;/b&gt;　&lt;font style=&quot;font-size: 10px;&quot;&gt;AuthGuard('jwt')&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="213" width="275" height="60" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c6" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;auth/presentation/decorators/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;@CurrentUser()&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="345" y="213" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c7" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;auth/presentation/controllers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;POST /auth/register（201）　POST /auth/login（200）&lt;br&gt;POST /auth/refresh（200）　POST /auth/logout（204・JwtAuthGuard 必須）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="283" width="565" height="122" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c8" value="&lt;b&gt;infrastructure/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="620" height="330" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c9" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;entities/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;UserOrmEntity&lt;/b&gt;（users）&lt;font style="font-size: 10px;"&gt; extends AuditableOrmEntity&lt;/font&gt;&lt;br&gt;&lt;b&gt;RefreshTokenOrmEntity&lt;/b&gt;（auth）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;は継承しない（回転は DELETE + INSERT なので updatedAt が無意味）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="120" width="285" height="100" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c10" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;users/infrastructure/mappers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ormToUser&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #777777;"&gt;&lt;b&gt;shared/infrastructure/errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;isUniqueViolationError&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="295" height="100" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c11" value="repositories/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="728" y="232" width="302" height="180" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c12" value="services/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1030" y="232" width="302" height="180" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c13" value='&lt;b&gt;TypeOrmUser&lt;br&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;（users）&lt;br&gt;unique 違反 →&lt;br&gt;EmailAlready&lt;br&gt;RegisteredError&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="258" width="140" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c14" value='&lt;b&gt;TypeOrmRefresh&lt;br&gt;TokenRepository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;SHA-256 で保存&lt;br&gt;timingSafeEqual&lt;br&gt;で照合&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="885" y="258" width="140" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c15" value='&lt;b&gt;Bcrypt&lt;br&gt;PasswordHasher&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;bcrypt で&lt;br&gt;hash / compare&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1035" y="258" width="140" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c16" value='&lt;b&gt;JwtTokenIssuer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;access / refresh を&lt;br&gt;署名・検証&lt;br&gt;（@nestjs/jwt）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1185" y="258" width="140" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c17" value="✕" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;startArrow=open;endArrow=open;dashed=1;strokeWidth=2;strokeColor=#d6336c;fontColor=#d6336c;fontSize=14;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="300" as="sourcePoint" /><mxPoint x="720" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="clean-auth-c18" value='&lt;font style="font-size: 10px; color: #d6336c;"&gt;ESLint で&lt;br&gt;禁止&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="642" y="318" width="76" height="40" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c19" value="&lt;b&gt;application/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1300" height="360" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c20" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;inputs/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;toRegisterInput&lt;br&gt;toLoginInput&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;契約型 → Command 型&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="485" width="190" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c21" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;validators/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;RegisterValidator&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;メール重複 →&lt;br&gt;EmailAlreadyRegisteredError（409）&lt;br&gt;組み立てる物が無いので void&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="265" y="485" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c22" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;usecases/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;RegisterUseCase&lt;br&gt;LoginUseCase&lt;br&gt;RefreshUseCase&lt;br&gt;LogoutUseCase&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="485" width="225" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c23" value="&lt;b&gt;ports/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="475" width="605" height="165" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c24" value='«interface»&lt;br&gt;&lt;b&gt;UserRepository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;USER_REPOSITORY&lt;br&gt;findByEmail&lt;br&gt;findById / create&lt;br&gt;&lt;i&gt;users 所有&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="735" y="503" width="140" height="125" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c25" value='«interface»&lt;br&gt;&lt;b&gt;RefreshToken&lt;br&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;save / findMatch&lt;br&gt;consumeById&lt;br&gt;deleteAllForUser&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="885" y="503" width="140" height="125" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c26" value='«interface»&lt;br&gt;&lt;b&gt;PasswordHasher&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;PASSWORD_HASHER&lt;br&gt;hash / compare&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1035" y="503" width="140" height="125" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c27" value='«interface»&lt;br&gt;&lt;b&gt;TokenIssuer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;TOKEN_ISSUER&lt;br&gt;issueAccessToken&lt;br&gt;issueRefreshToken&lt;br&gt;verifyRefreshToken&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1185" y="503" width="140" height="125" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c28" value="&lt;b&gt;refresh の回転&lt;/b&gt;（RefreshUseCase）&lt;br&gt;1. TokenIssuer.verifyRefreshToken（署名・期限）&lt;br&gt;2. RefreshTokenRepository.findMatch（保存済みか）&lt;br&gt;3. UserRepository.findById&lt;br&gt;4. consumeById（1 回限り。競合で負けたら 401）&lt;br&gt;5. issueAuthTokens で新しい組を発行" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="405" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c29" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;services/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;issueAuthTokens()&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;access ＋ refresh を発行し&lt;br&gt;refresh を保存する&lt;br&gt;（register / login / refresh で共有）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="225" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c30" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;users/application/mappers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;toContractUser&lt;/b&gt;(User) → 契約 User&lt;br&gt;&lt;font style="font-size: 10px;"&gt;id / email / displayName / createdAt だけを返す（passwordHash を外に出さない）&lt;br&gt;LoginUseCase は『メール不存在』と『パスワード不一致』を同じ InvalidCredentialsError にする（アカウント列挙を防ぐ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="605" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c31" value="&lt;b&gt;domain/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="240" y="840" width="900" height="215" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c32" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;users/domain/entities/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;User&lt;/b&gt;（Entity）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;passwordHash は照合用に保持&lt;br&gt;（契約には出さない）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="260" y="875" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c33" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;auth/domain/errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;InvalidCredentialsError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;unauthorized&lt;/font&gt;&lt;br&gt;&lt;b&gt;InvalidRefreshTokenError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;unauthorized&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="575" y="875" width="265" height="165" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c34" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;users/domain/errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;EmailAlreadyRegisteredError&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;conflict&lt;br&gt;RegisterValidator（事前確認）と&lt;br&gt;TypeOrmUserRepository（unique 制約・同時登録の競合）の両方から投げる&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="855" y="875" width="270" height="165" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c35" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.17;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c7" target="clean-auth-c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c36" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.94;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c7" target="clean-auth-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c37" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c22" target="clean-auth-c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c38" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c22" target="clean-auth-c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c39" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c22" target="clean-auth-c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="671" y="463" /><mxPoint x="1255" y="463" /></Array></mxGeometry></mxCell>
        <mxCell id="clean-auth-c40" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c22" target="clean-auth-c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c41" value="User" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c29" target="clean-auth-c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
