        <mxCell id="clean-tasks-c20" value='&lt;font style="font-size: 10px; color: #d6336c;"&gt;ESLint で&lt;br&gt;禁止&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="642" y="318" width="76" height="40" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c21" value="&lt;b&gt;application/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1300" height="360" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c22" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;inputs/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;toCreateTaskInput&lt;br&gt;toUpdateTaskInput&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;契約型 → Command 型&lt;br&gt;ISO 文字列 → Date はここで&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="485" width="190" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c23" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;query-services/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ListTasksQueryService&lt;br&gt;GetTaskQueryService&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;読み取り（CQRS-lite）&lt;br&gt;不存在 404 / 非所有 403 を自前で判定&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="265" y="485" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c24" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;usecases/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CreateTaskUseCase&lt;br&gt;UpdateTaskUseCase&lt;br&gt;DeleteTaskUseCase&lt;br&gt;SetTaskImageUseCase&lt;br&gt;RemoveTaskImageUseCase&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="485" width="225" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c25" value="&lt;b&gt;ports/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="475" width="605" height="160" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c26" value='«interface»&lt;br&gt;&lt;b&gt;TaskRepository&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;TASK_REPOSITORY&lt;br&gt;findById / listByUserId&lt;br&gt;create / update / deleteById&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="745" y="503" width="175" height="120" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c27" value='«interface»&lt;br&gt;&lt;b&gt;TaskQuery&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;TASK_QUERY&lt;br&gt;listByUserId&lt;br&gt;findByIdWithOwner&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="503" width="170" height="120" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c28" value='«interface»&lt;br&gt;&lt;b&gt;ImageStorage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;IMAGE_STORAGE&lt;br&gt;save / remove&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1130" y="503" width="185" height="120" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c29" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;mappers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;toContractTask&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;domain Task → 契約 Task&lt;br&gt;（usecases が戻り値に使う）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="190" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c30" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;read-models/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TaskReadModel&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;= 契約 Task&lt;br&gt;読み取りは domain Task を&lt;br&gt;生成しない&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="265" y="650" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c31" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;validators/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CreateTaskValidator&lt;/b&gt; → NewTask&lt;br&gt;&lt;b&gt;UpdateTaskValidator&lt;/b&gt; → Task&lt;br&gt;&lt;font style="font-size: 10px;"&gt;業務ルール検証の唯一の実体。&lt;br&gt;検証済みドメインオブジェクトを返す&lt;br&gt;（DB read が 1 回で済む）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="650" width="225" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c32" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;services/（ドメインサービス）&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TaskAccessService&lt;/b&gt;.loadOwned(userId, id)&lt;br&gt;&lt;font style="font-size: 10px;"&gt;findById → 無ければ TaskNotFoundError（404）&lt;br&gt;task.assertOwnedBy → TaskAccessDeniedError（403）&lt;br&gt;Port 越しの取得が要るため domain に置けない&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="290" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c33" value="application は TypeORM・fs・HTTP を知らない。受け取るのは &lt;b&gt;@Inject(TOKEN)&lt;/b&gt; された Port だけ。実装（TypeORM / fs）は tasks.module.ts が外から差し込む。&lt;br&gt;&lt;br&gt;→ 単体テストは Port（外部 I/O）をモックするだけで済み、業務ロジックはモックしない。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1025" y="650" width="300" height="145" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c34" value="&lt;b&gt;domain/&lt;/b&gt;　中核：フレームワーク非依存（NestJS も TypeORM も import しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;align=right;spacingRight=14;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="240" y="840" width="900" height="235" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c35" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;entities/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Task&lt;/b&gt;（Entity：id で同一性）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;static draft() → NewTask&lt;br&gt;static fromState()&lt;br&gt;assertOwnedBy()　applyUpdate()&lt;br&gt;attachImage()　detachImage()　toState()&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="260" y="875" width="300" height="185" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c36" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;value-objects/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DateRange&lt;/b&gt;（VO：不変）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;static of(start, end)&lt;br&gt;開始 ≤ 終了 を生成時に検証&lt;br&gt;withStart / withEnd / equals&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="575" y="875" width="250" height="185" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c37" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;errors/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;&lt;b&gt;TaskNotFoundError&lt;/b&gt;　not_found&lt;br&gt;&lt;b&gt;TaskAccessDeniedError&lt;/b&gt;　forbidden&lt;br&gt;&lt;b&gt;InvalidDateRangeError&lt;/b&gt;　invalid&lt;br&gt;&lt;b&gt;UnsupportedImageTypeError&lt;/b&gt;　invalid&lt;br&gt;&lt;br&gt;extends DomainError（shared/domain/errors/）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="840" y="875" width="285" height="185" as="geometry" /></mxCell>
        <mxCell id="clean-tasks-c38" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-tasks-c7" target="clean-tasks-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
