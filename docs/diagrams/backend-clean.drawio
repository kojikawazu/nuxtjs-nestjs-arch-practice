        <mxCell id="clean-auth-c43" value="implements" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c14" target="clean-auth-c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c44" value="implements" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c15" target="clean-auth-c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c45" value="implements" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c16" target="clean-auth-c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c46" value="&lt;b&gt;feature 間の依存&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1380" y="90" width="300" height="470" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c47" value="&lt;b&gt;tasks&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1430" y="130" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c48" value="&lt;b&gt;auth&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1430" y="240" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c49" value='&lt;b&gt;users&lt;/b&gt;　&lt;font style="font-size: 10px;"&gt;（presentation なし）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1430" y="350" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c50" value="JwtAuthGuard・@CurrentUser&lt;br&gt;を再利用" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c47" target="clean-auth-c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c51" value="imports UsersModule&lt;br&gt;（USER_REPOSITORY）" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-auth-c48" target="clean-auth-c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="clean-auth-c52" value='&lt;font style="font-size: 11px;"&gt;UsersModule が exports するのは USER_REPOSITORY だけ＝users への窓口は 1 本。&lt;br&gt;&lt;br&gt;auth の application は users の ports / domain / mappers を import する（feature 間でも内向きの依存は許可）。&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1395" y="410" width="275" height="140" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c53" value="&lt;b&gt;合成ルート&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;auth.module.ts&lt;/b&gt;&lt;br&gt;PASSWORD_HASHER → BcryptPasswordHasher&lt;br&gt;TOKEN_ISSUER → JwtTokenIssuer&lt;br&gt;REFRESH_TOKEN_REPOSITORY&lt;br&gt;　→ TypeOrmRefreshTokenRepository&lt;br&gt;&lt;br&gt;&lt;b&gt;users.module.ts&lt;/b&gt;&lt;br&gt;USER_REPOSITORY → TypeOrmUserRepository&lt;br&gt;（exports: [USER_REPOSITORY]）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1380" y="580" width="300" height="230" as="geometry" /></mxCell>
        <mxCell id="clean-auth-c54" value="&lt;b&gt;秘密値の扱い&lt;/b&gt;&lt;br&gt;&lt;br&gt;パスワード：bcrypt（BcryptPasswordHasher）。上限は文字数ではなく UTF-8 の 72 バイト。&lt;br&gt;&lt;br&gt;refresh トークン：SHA-256 ハッシュで保存し、照合は timingSafeEqual。DB が漏れても生トークンは残らない。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="830" width="300" height="225" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="request-flow" name="4. リクエストの流れ">
    <mxGraphModel dx="1720" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="request-flow-c1" value='&lt;b&gt;リクエストの流れ（backend-clean / tasks）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;書き込み（Command）と読み取り（Query）で通る層と Port が違う。①〜は実行順。赤字は途中で止まる場合のステータス（DomainError / HttpException → AllExceptionsFilter）&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="request-flow-c2" value="&lt;b&gt;書き込み（Command）　PATCH /tasks/:id&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="780" height="30" as="geometry" /></mxCell>
        <mxCell id="request-flow-c3" value="&lt;b&gt;presentation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="195" height="900" as="geometry" /></mxCell>
        <mxCell id="request-flow-c4" value="&lt;b&gt;application&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="130" width="195" height="900" as="geometry" /></mxCell>
        <mxCell id="request-flow-c5" value="&lt;b&gt;domain&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="195" height="900" as="geometry" /></mxCell>
        <mxCell id="request-flow-c6" value="&lt;b&gt;infrastructure&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="130" width="195" height="900" as="geometry" /></mxCell>
        <mxCell id="request-flow-c7" value='① &lt;b&gt;JwtAuthGuard&lt;/b&gt;&lt;br&gt;access JWT を検証&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;失敗 → 401&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="52" y="165" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c8" value='② &lt;b&gt;ZodValidationPipe&lt;/b&gt;&lt;br&gt;(updateTaskSchema)&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;形式違反 → 422&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="52" y="245" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c9" value="③ &lt;b&gt;TasksController&lt;/b&gt;&lt;br&gt;.update(user, id, body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="52" y="325" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c10" value='④ &lt;b&gt;toUpdateTaskInput&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;契約型 → UpdateTaskInput&lt;br&gt;ISO 文字列 → Date&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="247" y="325" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c11" value="⑤ &lt;b&gt;UpdateTaskUseCase&lt;/b&gt;&lt;br&gt;.execute(input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="247" y="410" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c12" value="⑥ &lt;b&gt;UpdateTaskValidator&lt;/b&gt;&lt;br&gt;.execute(input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="247" y="490" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c13" value="⑦ &lt;b&gt;TaskAccessService&lt;/b&gt;&lt;br&gt;.loadOwned(userId, id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="247" y="570" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c14" value='⑧ &lt;b&gt;TypeOrmTaskRepository&lt;/b&gt;&lt;br&gt;.findById → ormToDomain&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;無ければ 404&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="637" y="570" width="171" height="70" as="geometry" /></mxCell>
        <mxCell id="request-flow-c15" value='⑨ &lt;b&gt;task.assertOwnedBy&lt;/b&gt;&lt;br&gt;(userId)&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;非所有 → 403&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="442" y="660" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c16" value='⑩ &lt;b&gt;task.applyUpdate&lt;/b&gt;(patch)&lt;br&gt;DateRange.of で再検証&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;開始 &gt; 終了 → 422&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="442" y="745" width="171" height="70" as="geometry" /></mxCell>
        <mxCell id="request-flow-c17" value='⑪ &lt;b&gt;TaskRepository.update&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;domainToOrm → save&lt;br&gt;→ ormToDomain&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="637" y="840" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c18" value="⑫ &lt;b&gt;toContractTask&lt;/b&gt;&lt;br&gt;domain Task → 契約 Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="247" y="930" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c19" value="⑬ &lt;b&gt;200&lt;/b&gt; Task（JSON）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="52" y="930" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c20" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c7" target="request-flow-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c21" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c8" target="request-flow-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c22" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c9" target="request-flow-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c23" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c10" target="request-flow-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c24" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c11" target="request-flow-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c25" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c12" target="request-flow-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c26" value="TaskRepository（Port）" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c13" target="request-flow-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c27" value="Task が返る" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="request-flow-c14" target="request-flow-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c28" value="Validator が続けて" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c15" target="request-flow-c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c29" value="検証済み Task を保存" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c16" target="request-flow-c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c30" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c17" target="request-flow-c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c31" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c18" target="request-flow-c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c32" value='&lt;font style="font-size: 11px;"&gt;&lt;b&gt;Command 側は domain を必ず通る。&lt;/b&gt;&lt;br&gt;&lt;br&gt;ロード → ドメインの振る舞いで変更 → 保存、の順。不変条件（所有・期間）は Entity / VO が守るので、UseCase は検証済みの Task を保存するだけ。&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="442" y="165" width="171" height="150" as="geometry" /></mxCell>
        <mxCell id="request-flow-c33" value='&lt;font style="font-size: 11px;"&gt;&lt;b&gt;Port の向こう側&lt;/b&gt;&lt;br&gt;&lt;br&gt;⑧⑪ は application から見ると TaskRepository（interface）の呼び出し。TypeORM の実装はテストでモックに差し替えられる。&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="637" y="165" width="171" height="150" as="geometry" /></mxCell>
        <mxCell id="request-flow-c34" value="&lt;b&gt;読み取り（Query）　GET /tasks/:id&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="95" width="780" height="30" as="geometry" /></mxCell>
        <mxCell id="request-flow-c35" value="&lt;b&gt;presentation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="195" height="480" as="geometry" /></mxCell>
        <mxCell id="request-flow-c36" value="&lt;b&gt;application&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="130" width="195" height="480" as="geometry" /></mxCell>
        <mxCell id="request-flow-c37" value="&lt;b&gt;domain&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="195" height="480" as="geometry" /></mxCell>
        <mxCell id="request-flow-c38" value="&lt;b&gt;infrastructure&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1485" y="130" width="195" height="480" as="geometry" /></mxCell>
        <mxCell id="request-flow-c39" value='① &lt;b&gt;JwtAuthGuard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;失敗 → 401&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="912" y="165" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c40" value="② &lt;b&gt;TasksController&lt;/b&gt;&lt;br&gt;.get(user, id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="912" y="245" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c41" value="③ &lt;b&gt;GetTaskQueryService&lt;/b&gt;&lt;br&gt;.execute(userId, id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1107" y="245" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c42" value='④ &lt;b&gt;TypeOrmTaskQuery&lt;/b&gt;&lt;br&gt;.findByIdWithOwner(id)&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ORM 行 → { task: 契約 Task, ownerId }&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1497" y="245" width="171" height="80" as="geometry" /></mxCell>
        <mxCell id="request-flow-c43" value='⑤ owner を照合&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;row 無し → 404&lt;br&gt;ownerId ≠ userId → 403&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1107" y="345" width="171" height="80" as="geometry" /></mxCell>
        <mxCell id="request-flow-c44" value="⑥ &lt;b&gt;TaskReadModel&lt;/b&gt;&lt;br&gt;をそのまま返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1107" y="445" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c45" value="⑦ &lt;b&gt;200&lt;/b&gt; Task（JSON）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="912" y="445" width="171" height="62" as="geometry" /></mxCell>
        <mxCell id="request-flow-c46" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c39" target="request-flow-c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c47" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c40" target="request-flow-c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c48" value="TaskQuery（Port）" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c41" target="request-flow-c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c49" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c43" target="request-flow-c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c50" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="request-flow-c44" target="request-flow-c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c51" value="row を返す" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="request-flow-c42" target="request-flow-c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="request-flow-c52" value='&lt;font style="font-size: 11px;"&gt;&lt;b&gt;Query 側は domain Task を生成しない。&lt;/b&gt;&lt;br&gt;&lt;br&gt;domain から使うのは errors（TaskNotFoundError / TaskAccessDeniedError）だけ。参照に不要なエンティティ生成と 2 段マッピングを省く。&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1302" y="445" width="171" height="150" as="geometry" /></mxCell>
        <mxCell id="request-flow-c53" value='&lt;b&gt;Command と Query の違い&lt;/b&gt;（CQRS-lite）&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 11px; border-collapse: collapse;" border="1" cellpadding="5"&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;書き込み（Command）&lt;/th&gt;&lt;th&gt;読み取り（Query）&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;入口&lt;/td&gt;&lt;td&gt;usecases/ ＋ validators/&lt;/td&gt;&lt;td&gt;query-services/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;依存する Port&lt;/td&gt;&lt;td&gt;TaskRepository（domain Task を返す）&lt;/td&gt;&lt;td&gt;TaskQuery（Read Model を直接返す）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;変換&lt;/td&gt;&lt;td&gt;ORM → domain → 契約（2 段）&lt;/td&gt;&lt;td&gt;ORM 行 → 契約（1 段）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;所有判定&lt;/td&gt;&lt;td&gt;TaskAccessService → Task.assertOwnedBy&lt;/td&gt;&lt;td&gt;Query Service が ownerId を比較&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;404 / 403&lt;/td&gt;&lt;td&gt;findById で引いてから判定&lt;/td&gt;&lt;td&gt;id だけで引き owner を添えて返す&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;where {id, userId} で短絡すると他人のタスクが 404 になり契約（403）に反するため、どちらも id だけで引いてから所有を判定する。&lt;br&gt;トレードオフ：所有判定と ORM→契約の変換が 2 か所に分かれる。tasks は読み取りが 2 本・検索なしなので、本リポジトリでは CQRS-lite の形を 1 か所示す学習用の比較例として置いている。&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="780" height="330" as="geometry" /></mxCell>
        <mxCell id="request-flow-c54" value="&lt;b&gt;どこで止まっても出口は 1 つ&lt;/b&gt;：DomainError（kind）・HttpException（Guard の 401 / Pipe の 422・413）は &lt;b&gt;AllExceptionsFilter&lt;/b&gt; が受け、&lt;b&gt;ApiError&lt;/b&gt; { statusCode, message, error, errors[] } に揃えて返す。業務エラーの kind → HTTP の対応は 2 ページ目。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f3;strokeColor=#d6336c;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1640" height="65" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="clean-vs-onion" name="5. clean vs onion">
    <mxGraphModel dx="1720" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="clean-vs-onion-c1" value='&lt;b&gt;clean と onion の差は『契約の所在』だけ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;クラス名・メソッド名・HTTP 契約・e2e シナリオは両版で同一。オレンジ枠が置き場所の変わるもの。依存はどちらも内向きで、層ルールは同じ ESLint 設定（backend-{clean,onion}）で強制される&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c2" value='&lt;b&gt;backend-clean&lt;/b&gt;　&lt;font style="font-size: 11px;"&gt;apps/backend-clean/src/api/tasks/&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="790" height="30" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c3" value="外側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="790" height="730" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c4" value='&lt;b&gt;presentation/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TasksController・zod DTO・Guard&lt;br&gt;（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c5" value='&lt;b&gt;infrastructure/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TypeOrmTaskRepository・TypeOrmTaskQuery&lt;br&gt;LocalImageStorage（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="450" y="160" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c6" value="&lt;b&gt;application/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="750" height="565" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c7" value='usecases/・validators/・inputs/・mappers/&lt;br&gt;&lt;font style="font-size: 11px;"&gt;（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="340" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c8" value='&lt;b&gt;query-services/ ＋ read-models/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;List / GetTaskQueryService&lt;br&gt;→ TaskReadModel（= 契約 Task）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="440" y="310" width="320" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c9" value='&lt;b&gt;application/ports/&lt;/b&gt;　契約（interface ＋ DI トークン）&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TaskRepository・TaskQuery・ImageStorage&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="690" height="95" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c10" value='&lt;b&gt;application/services/&lt;/b&gt;　ドメインサービス&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TaskAccessService&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="690" height="80" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c11" value="&lt;b&gt;domain/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="690" height="205" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c12" value="entities/ Task ・ value-objects/ DateRange ・ errors/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="100" y="655" width="650" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c13" value='&lt;font style="font-size: 11px;"&gt;domain は契約を知らない。Task / DateRange / errors だけの純粋な中核&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="740" width="650" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c14" value="implements" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-vs-onion-c5" target="clean-vs-onion-c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="457" /></Array></mxGeometry></mxCell>
        <mxCell id="clean-vs-onion-c15" value='&lt;b&gt;backend-onion&lt;/b&gt;　&lt;font style="font-size: 11px;"&gt;apps/backend-onion/src/modules/tasks/&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="95" width="790" height="30" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c16" value="外側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="890" y="130" width="790" height="730" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c17" value='&lt;b&gt;presentation/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TasksController・zod DTO・Guard&lt;br&gt;（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="910" y="160" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c18" value='&lt;b&gt;infrastructure/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TypeOrmTaskRepository・TypeOrmTaskQuery&lt;br&gt;LocalImageStorage（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1300" y="160" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c19" value="&lt;b&gt;application/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="910" y="275" width="750" height="565" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c20" value='usecases/・validators/・inputs/・mappers/&lt;br&gt;&lt;font style="font-size: 11px;"&gt;（両版で同じ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="310" width="340" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c21" value='&lt;b&gt;queries/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;List / GetTaskQuery&lt;br&gt;→ 契約 Task を直接返す（read-models/ なし）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1290" y="310" width="320" height="85" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c22" value="&lt;b&gt;domain/&lt;/b&gt;　中核が自分の必要とする契約を定義する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;arcSize=2;" vertex="1" parent="1"><mxGeometry x="930" y="410" width="690" height="415" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c23" value="entities/ Task ・ value-objects/ DateRange ・ errors/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="950" y="445" width="650" height="60" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c24" value='&lt;b&gt;domain/repositories/&lt;/b&gt;　契約（interface ＋ DI トークン）&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TaskRepository（task.repository.ts）・TaskQuery（task-query.ts）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="950" y="520" width="650" height="95" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c25" value='&lt;b&gt;domain/services/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TaskAccessService（ドメインサービス）・ImageStorage（契約）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#e8590c;strokeWidth=2;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="950" y="630" width="650" height="95" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c26" value='&lt;font style="font-size: 11px;"&gt;domain/repositories/ ↔ infrastructure/repositories/、domain/services/ ↔ infrastructure/services/ と同じ語彙で対称に置き、どの実装がどの契約を満たすかをフォルダ位置で辿れるようにする&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="740" width="650" height="70" as="geometry" /></mxCell>
        <mxCell id="clean-vs-onion-c27" value="implements" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-vs-onion-c18" target="clean-vs-onion-c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="567" /></Array></mxGeometry></mxCell>
        <mxCell id="clean-vs-onion-c28" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#9673a6;fontColor=#7a5a8c;edgeStyle=orthogonalEdgeStyle;exitX=0.97;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean-vs-onion-c18" target="clean-vs-onion-c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="677" /></Array></mxGeometry></mxCell>
        <mxCell id="clean-vs-onion-c29" value='&lt;table style="font-size: 12px; border-collapse: collapse; width: 100%;" border="1" cellpadding="5"&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;backend-clean&lt;/th&gt;&lt;th&gt;backend-onion&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;契約（Port）の所在&lt;/td&gt;&lt;td&gt;application/ports/（ユースケースが必要とする契約）&lt;/td&gt;&lt;td&gt;domain/repositories/・domain/services/（中核が必要とする契約）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TaskAccessService&lt;/td&gt;&lt;td&gt;application/services/（Port を使うので domain に置けない）&lt;/td&gt;&lt;td&gt;domain/services/（契約が domain にあるので置ける）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;読み取り（CQRS-lite）&lt;/td&gt;&lt;td&gt;query-services/ ＋ read-models/&lt;/td&gt;&lt;td&gt;queries/（契約 Task を直接返す）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;auth / users の契約&lt;/td&gt;&lt;td&gt;application/ports/（UserRepository・PasswordHasher・TokenIssuer・RefreshTokenRepository）&lt;/td&gt;&lt;td&gt;domain/repositories/（UserRepository・RefreshTokenRepository）・domain/services/（PasswordHasher・TokenIssuer）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;feature のルート&lt;/td&gt;&lt;td&gt;src/api/{tasks,auth,users}/&lt;/td&gt;&lt;td&gt;src/modules/{tasks,auth,users}/&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1640" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ports-adapters" name="6. Ports and Adapters">
    <mxGraphModel dx="1720" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ports-adapters-c1" value='&lt;b&gt;Ports and Adapters（ヘキサゴナルアーキテクチャ）で見た backend-clean&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;中心（application ＋ domain）は外の技術を知らない。外との接点は Port（中心が決める口）と Adapter（その口に具体的な技術をつなぐ実装）だけ。左が中心を&lt;b&gt;駆動する側&lt;/b&gt;（Primary）、右が中心に&lt;b&gt;駆動される側&lt;/b&gt;（Secondary）&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c2" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=110;direction=south;fillColor=#f1f8ee;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="600" height="860" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c3" value='&lt;b&gt;アプリケーションの中心&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;application ＋ domain（TypeORM・fs・HTTP を import しない）&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c4" value='&lt;font style="font-size: 10px; color: #82b366;"&gt;&lt;b&gt;application/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;inputs/（契約型 → Command）&lt;br&gt;validators/（業務ルール検証）&lt;br&gt;services/ TaskAccessService・issueAuthTokens&lt;br&gt;mappers/（domain → 契約）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="245" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c5" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=60;direction=south;fillColor=#fff8e6;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="320" height="330" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c6" value='&lt;b&gt;domain/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;Task・User（Entity）&lt;br&gt;DateRange（VO）&lt;br&gt;DomainError（kind）&lt;br&gt;&lt;br&gt;フレームワーク非依存の業務ルール&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="730" y="480" width="260" height="210" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c7" value='&lt;font style="font-size: 11px;"&gt;UseCase は &lt;b&gt;@Inject(TOKEN)&lt;/b&gt; で Port を受け取るだけ。どの Adapter が刺さるかは *.module.ts（合成ルート）が決める。&lt;br&gt;Port を足す合図：中心から外の技術を import したくなったとき&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="800" width="340" height="110" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c8" value='&lt;b&gt;usecases/&lt;/b&gt;（tasks）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Create / Update / Delete&lt;br&gt;SetImage / RemoveImage&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="495" y="290" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c9" value='&lt;b&gt;query-services/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ListTasks / GetTask&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="495" y="380" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c10" value='&lt;b&gt;usecases/&lt;/b&gt;（auth）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Register / Login&lt;br&gt;Refresh / Logout&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;dashPattern=6 3;strokeWidth=2;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="495" y="560" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c11" value='&lt;font style="font-size: 10px;"&gt;&lt;b&gt;Primary Port&lt;/b&gt;&lt;br&gt;明示の interface は置かず、&lt;br&gt;UseCase クラス自身が口を兼ねる（Controller → UseCase はもともと内向きなので不要）&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c12" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;presentation/controllers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TasksController&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;zod DTO・ZodValidationPipe&lt;br&gt;JwtAuthGuard・@CurrentUser&lt;br&gt;Multer → ImageFile に詰め替え&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="260" y="290" width="190" height="150" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c13" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;presentation/controllers/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;JwtAccessStrategy&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="260" y="545" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c14" value='&lt;font style="font-size: 10px;"&gt;&lt;b&gt;Primary Adapter&lt;/b&gt;&lt;br&gt;HTTP を UseCase 呼び出しに翻訳&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="255" y="680" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="ports-adapters-c15" value='&lt;b&gt;ブラウザ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Nuxt SPA / SSR&lt;br&gt;（タスク API は Bearer で直接）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="175" height="70" as="geometry" /></mxCell>
