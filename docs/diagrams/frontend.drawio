<mxfile host="drawio" agent="Claude Code">
  <diagram id="fe-structure" name="1. 構成と依存の向き">
    <mxGraphModel dx="1720" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fe-structure-c1" value='&lt;b&gt;frontend の構成と依存の向き（frontend-spa / frontend-ssr 共通）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;副作用（HTTP・状態）は composables/ に集約し、pages / components は表示に専念する。タスク API はブラウザから backend へ直接、認証系だけ Nitro BFF を経由する。差分は赤字（ssr のみ）・青字（spa のみ）&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c2" value="&lt;b&gt;Nuxt アプリ&lt;/b&gt;　apps/frontend-spa（ssr: false）・apps/frontend-ssr（ssr: true）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1140" height="880" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c3" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;pages/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ルート＝ファイル&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;index / login / register&lt;br&gt;tasks/index・tasks/[id]/index・tasks/[id]/edit&lt;br&gt;tasks/new/index（入力）→ tasks/new/confirm（確認）← 両版で実装を分けている唯一の画面&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="520" height="150" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c4" value='&lt;font style="font-size: 10px; color: #6c8ebf;"&gt;&lt;b&gt;components/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;表示に専念&lt;/b&gt;（props / emit。HTTP は呼ばない）&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TaskForm・TaskCard・TaskStatusBadge・UrlPreview&lt;br&gt;ConfirmDialog・FlatpickrInput・AppHeader&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="560" height="150" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c5" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c3" target="fe-structure-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c6" value='&lt;font style="font-size: 10px; color: #666666;"&gt;&lt;b&gt;middleware/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;auth.global.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;access が無い → /login&lt;br&gt;ログイン済みで /login・/register → /tasks&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="250" height="120" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c7" value='&lt;font style="font-size: 10px; color: #666666;"&gt;&lt;b&gt;plugins/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;auth-init&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;起動時に refresh でセッション復元&lt;br&gt;&lt;/font&gt;&lt;font style="font-size: 10px; color: #1971c2;"&gt;spa: auth-init.client.ts（ブラウザだけ）&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;ssr: auth-init.ts（サーバでも実行）&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="325" y="330" width="255" height="120" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c8" value="&lt;b&gt;composables/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="560" height="280" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c9" value='&lt;b&gt;useTasks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;list / get / create / update&lt;br&gt;remove / uploadImage / removeImage&lt;br&gt;応答を taskSchema で検証&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="615" y="350" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c10" value='&lt;b&gt;useApiClient&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;openapi-fetch の&lt;br&gt;createApiClient&lt;br&gt;&lt;/font&gt;&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;ssr: サーバでは apiBaseUrl&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="795" y="350" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c11" value='&lt;b&gt;useAuthedFetch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Bearer を付けて送信&lt;br&gt;401 なら 1 回だけ&lt;br&gt;renew して再送&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="975" y="350" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c12" value='&lt;b&gt;useTaskDraft&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #1971c2;"&gt;spa のみ&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;draft を sessionStorage に&lt;br&gt;（taskDraftSchema で検証）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="615" y="475" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c13" value='&lt;b&gt;useAuthState&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;useState&lt;br&gt;accessToken / user&lt;br&gt;（メモリだけ）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="795" y="475" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c14" value='&lt;b&gt;useAuth&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;login / register / refresh&lt;br&gt;logout / renewSession&lt;br&gt;（refresh を 1 本に束ねる）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="975" y="475" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c15" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c3" target="fe-structure-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c16" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c9" target="fe-structure-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c17" value="fetch に注入" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c10" target="fe-structure-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c18" value="401" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c11" target="fe-structure-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c19" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c14" target="fe-structure-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c20" value='&lt;font style="font-size: 10px; color: #9c6a00;"&gt;&lt;b&gt;utils/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;&lt;b&gt;taskFormSchema&lt;/b&gt;：フォームの検証（zod）&lt;br&gt;&lt;b&gt;taskSchema&lt;/b&gt;：backend の応答をランタイム検証（壊れた形は 500 として UI に流さない）&lt;br&gt;&lt;b&gt;safeUrl&lt;/b&gt;：isSafeHttpUrl（http / https 以外のリンクを出さない）&lt;br&gt;&lt;b&gt;fieldErrors・getErrorMessage&lt;/b&gt;：ApiError.errors → フィールド別の表示&lt;br&gt;&lt;/font&gt;&lt;font style="font-size: 10px; color: #1971c2;"&gt;taskDraftSchema（sessionStorage の draft を検証）&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;draftSize（Cookie 上限をクライアントとサーバで同じ基準で判定）&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="520" height="190" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c21" value="TaskForm" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c4" target="fe-structure-c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="275" /><mxPoint x="590" y="620" /><mxPoint x="528" y="620" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-structure-c22" value="型は &lt;b&gt;@app/api-client&lt;/b&gt; を import type で参照（backend と同じ契約）。単体テストは backend への HTTP を &lt;b&gt;MSW&lt;/b&gt;、BFF を &lt;b&gt;registerEndpoint&lt;/b&gt; でモックし、コンポーネントは mountSuspended でマウントする。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="520" height="110" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c23" value="&lt;b&gt;server/&lt;/b&gt;　Nitro（サーバでだけ動く BFF）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="560" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c24" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;server/api/auth/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;login / register / refresh / logout&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;backend の /auth/* に中継し、&lt;br&gt;refresh を httpOnly Cookie に閉じ込める。&lt;br&gt;ブラウザへ返すのは accessToken ＋ user だけ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="615" y="655" width="265" height="135" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c25" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;server/utils/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;auth-bff.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;set / get / clearRefreshCookie&lt;br&gt;forwardAuth（失敗は status を引き継ぐ）&lt;br&gt;refresh_token：httpOnly・SameSite=Lax・7 日&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="655" width="255" height="135" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c26" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;server/api/tasks/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;draft.get / post / delete&lt;/b&gt;　&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;ssr のみ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;draft を Cookie task_draft に保存&lt;br&gt;（backend へは中継しない）&lt;br&gt;3,500 バイト超は 413&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="615" y="805" width="265" height="140" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c27" value='&lt;font style="font-size: 10px; color: #9673a6;"&gt;&lt;b&gt;server/utils/&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;draft-bff.ts&lt;/b&gt;　&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;ssr のみ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;taskDraftSchema で形式検証&lt;br&gt;task_draft：httpOnly・30 分で失効&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="805" width="255" height="140" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c28" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c24" target="fe-structure-c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c29" value="$fetch /api/auth/*" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c14" target="fe-structure-c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c30" value='&lt;b&gt;ブラウザ側の保存先&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 11px; border-collapse: collapse;" border="1" cellpadding="4"&gt;&lt;tr&gt;&lt;td&gt;メモリ（useState）&lt;/td&gt;&lt;td&gt;accessToken・user・draft の画像 File&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;httpOnly Cookie&lt;/td&gt;&lt;td&gt;refresh_token（JS から読めない）・ssr の task_draft&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;sessionStorage&lt;/td&gt;&lt;td&gt;spa の draft（JS から読める）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;localStorage&lt;/td&gt;&lt;td&gt;&lt;b&gt;使わない&lt;/b&gt;（XSS で長命な値が漏れる）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1230" y="100" width="450" height="200" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c31" value='&lt;b&gt;backend&lt;/b&gt;（layered / clean / onion のどれでも差し替え可）&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;&lt;b&gt;/tasks/*&lt;/b&gt;：ブラウザから Bearer で直接（ssr はサーバからも）&lt;br&gt;&lt;b&gt;/auth/*&lt;/b&gt;：BFF だけが呼ぶ（ssr はサーバ側の refresh も直接）&lt;br&gt;&lt;br&gt;3 版とも同じ契約・同じ e2e シナリオなので、frontend はどの版にも繋がる&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="450" height="260" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c32" value="/tasks/*（Bearer）" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c11" target="fe-structure-c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-structure-c33" value="/auth/*" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-structure-c25" target="fe-structure-c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="722" /><mxPoint x="1195" y="551" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-structure-c34" value='&lt;b&gt;@app/api-client&lt;/b&gt;（packages/ ・ pnpm api:gen）&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;TypeSpec（main.tsp）→ OpenAPI → 型と createApiClient を生成。&lt;br&gt;frontend / backend が同じ型（Task / User / ApiError など）を import type で参照する&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1230" y="620" width="450" height="150" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c35" value="&lt;b&gt;なぜ認証だけ BFF を通すのか&lt;/b&gt;&lt;br&gt;&lt;br&gt;長命な refresh をブラウザの JS に一度も見せないため。タスク API は短命な access だけで足りるので、BFF を挟まず直接送る（中継の分だけ遅くならない）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="800" width="450" height="160" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c36" value="" style="rounded=1;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c37" value="pages / components（表示）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c38" value="" style="rounded=1;html=1;fillColor=#f1f8ee;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="285" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c39" value="composables（HTTP・状態）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="317" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c40" value="" style="rounded=1;html=1;fillColor=#fff8e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c41" value="utils（zod・判定）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="562" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c42" value="" style="rounded=1;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="775" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c43" value="server/（Nitro BFF）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="807" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c44" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1020" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c45" value="middleware / plugins" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1052" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c46" value="" style="rounded=1;html=1;fillColor=#fff4e6;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1265" y="1004" width="26" height="16" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c47" value="backend・契約" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1297" y="1000" width="230" height="24" as="geometry" /></mxCell>
        <mxCell id="fe-structure-c48" value='&lt;font style="font-size: 10px; color: #c2255c;"&gt;&lt;b&gt;ssr のみ&lt;/b&gt;&lt;/font&gt;／&lt;font style="font-size: 10px; color: #1971c2;"&gt;spa のみ&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="1000" width="180" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fe-auth" name="2. 認証の流れ">
    <mxGraphModel dx="1720" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fe-auth-c1" value='&lt;b&gt;認証の流れ（frontend-spa。ssr もブラウザ上では同じ）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;access はメモリ（useState）、refresh は BFF が httpOnly Cookie に閉じ込める。タスク API は BFF を通らず backend へ直接 Bearer で送る。サーバ側で動く ssr の違いは 3 ページ目&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c2" value="&lt;b&gt;A. ログイン&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="400" height="26" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c3" value="&lt;b&gt;ブラウザ（Vue・composables）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="520" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c4" value="&lt;b&gt;Nitro BFF（server/api/auth/）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="125" width="460" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c5" value="&lt;b&gt;backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="125" width="440" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c6" value="① &lt;b&gt;login.vue&lt;/b&gt; → useAuth().&lt;b&gt;login&lt;/b&gt;(body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="165" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c7" value='② &lt;b&gt;POST /api/auth/login&lt;/b&gt;（login.post.ts）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;forwardAuth で backend へ中継&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="165" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c8" value='③ &lt;b&gt;POST /auth/login&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;→ { accessToken, refreshToken, user }&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1050" y="165" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c9" value='④ &lt;b&gt;setRefreshCookie&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;httpOnly・SameSite=Lax・7 日。応答から refreshToken を外す&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="265" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c10" value='⑤ { accessToken, user } を &lt;b&gt;useState&lt;/b&gt;（メモリ）へ&lt;br&gt;&lt;font style="font-size: 10px;"&gt;refresh は JS から一度も見えない&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="265" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c11" value="⑥ navigateTo('/tasks')&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;auth.global.ts は accessToken の有無で通す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="365" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c12" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c6" target="fe-auth-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c13" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c7" target="fe-auth-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c14" value="tokens" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c8" target="fe-auth-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c15" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c9" target="fe-auth-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c16" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c10" target="fe-auth-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c17" value="&lt;b&gt;B. タスク API と access の失効（401）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="600" height="26" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c18" value="&lt;b&gt;ブラウザ（Vue・composables）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="520" height="540" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c19" value="&lt;b&gt;Nitro BFF（server/api/auth/）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="460" height="540" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c20" value="&lt;b&gt;backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="440" height="540" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c21" value="① useTasks().&lt;b&gt;list&lt;/b&gt;() → useApiClient（openapi-fetch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="560" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c22" value='② &lt;b&gt;useAuthedFetch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Authorization: Bearer &amp;lt;access&amp;gt; を付けて送信（request.clone() を控えておく）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c23" value='③ &lt;b&gt;GET /tasks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;access 失効 → 401&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1050" y="650" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c24" value='④ useAuth().&lt;b&gt;renewSession&lt;/b&gt;()&lt;br&gt;&lt;font style="font-size: 10px;"&gt;並行する 401 は実行中の 1 本の refresh を共有（WeakMap）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="740" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c25" value='⑤ &lt;b&gt;POST /api/auth/refresh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Cookie の refresh_token を backend へ渡す&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c26" value='⑥ &lt;b&gt;POST /auth/refresh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;1 回限りで消費し、新しい組を発行（回転）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1050" y="740" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c27" value='⑦ 新しい refresh を &lt;b&gt;Set-Cookie&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ブラウザへは accessToken ＋ user だけ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="830" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c28" value='⑧ access を更新し、控えた request を&lt;b&gt;1 回だけ&lt;/b&gt;再送&lt;br&gt;&lt;font style="font-size: 10px;"&gt;→ 200 なら useTasks が taskSchema で検証して返す&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="830" width="380" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c29" value='renew に失敗したとき&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;endSession：useState を消し /api/auth/logout → /login へ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="110" y="950" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c30" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c21" target="fe-auth-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c31" value="Bearer で直接（BFF を通らない）" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c22" target="fe-auth-c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c32" value="401" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;strokeColor=#d6336c;fontColor=#d6336c;edgeStyle=orthogonalEdgeStyle;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c23" target="fe-auth-c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1126" y="727" /><mxPoint x="414" y="727" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-auth-c33" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c24" target="fe-auth-c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c34" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c25" target="fe-auth-c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c35" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c26" target="fe-auth-c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c36" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c27" target="fe-auth-c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-auth-c37" value="refresh 失敗" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;strokeColor=#d6336c;fontColor=#d6336c;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-auth-c24" target="fe-auth-c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="772" /><mxPoint x="85" y="990" /></Array></mxGeometry></mxCell>
        <mxCell id="fe-auth-c38" value='&lt;b&gt;置き場所の理由&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;&lt;b&gt;access&lt;/b&gt;：短命。メモリだけに置き、リロードで消えたら refresh で取り直す&lt;br&gt;&lt;br&gt;&lt;b&gt;refresh&lt;/b&gt;：長命。httpOnly Cookie なので XSS でも JS から読めない&lt;br&gt;&lt;br&gt;&lt;b&gt;localStorage&lt;/b&gt;：使わない&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="125" width="190" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-auth-c39" value='&lt;b&gt;401 の扱い&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size: 11px;"&gt;再送は &lt;b&gt;1 回だけ&lt;/b&gt;。refresh 後も 401 なら無限に繰り返さない。&lt;br&gt;&lt;br&gt;同時に 3 本の API が 401 になっても refresh は 1 本（renewSession が実行中の Promise を共有）。refresh は回転するので、並行に投げると 2 本目以降が古いトークンで弾かれる。&lt;br&gt;&lt;br&gt;BFF はブラウザと同一オリジンなので、Cookie は自動で付く。&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffef0;strokeColor=#b8a46b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="520" width="190" height="540" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fe-render" name="3. SPA と SSR の初回表示">
    <mxGraphModel dx="1720" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1090" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fe-render-c1" value='&lt;b&gt;SPA と SSR の差：/tasks を直接開いたとき、いつ・どこで・何が動くか&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;左から右へ時間が進む。緑の太枠が『一覧が画面に出る』瞬間。SPA はブラウザが JS を読んでから復元と取得を行い、SSR は最初のリクエストの中でサーバが復元・取得・描画まで済ませる&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-render-c2" value="&lt;b&gt;frontend-spa（ssr: false）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1200" height="28" as="geometry" /></mxCell>
        <mxCell id="fe-render-c3" value="" style="rounded=0;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c4" value="&lt;b&gt;ブラウザ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="170" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c5" value="" style="rounded=0;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c6" value="&lt;b&gt;Nuxt サーバ（Nitro）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="295" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c7" value="" style="rounded=0;html=1;fillColor=#fff4e6;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c8" value="&lt;b&gt;backend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="420" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c9" value="① /tasks を開く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="142" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c10" value='② 中身の無いシェル HTML を返す&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ssr: false&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="375" y="267" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c11" value='③ JS を読み込む&lt;br&gt;&lt;b&gt;auth-init.client.ts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;useAuth().refresh()&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="560" y="142" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c12" value='④ &lt;b&gt;BFF /api/auth/refresh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Cookie の refresh を中継&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="745" y="267" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c13" value='⑤ &lt;b&gt;POST /auth/refresh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;回転した新しい組&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="392" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c14" value="⑥ useState に access&lt;br&gt;middleware を通過&lt;br&gt;useTasks().list()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1115" y="142" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c15" value='⑦ &lt;b&gt;GET /tasks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ブラウザから Bearer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1300" y="392" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c16" value='⑧ &lt;b&gt;一覧を描画&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ここで初めて内容が出る&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1485" y="142" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c17" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c9" target="fe-render-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c18" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c10" target="fe-render-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c19" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c11" target="fe-render-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c20" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c12" target="fe-render-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c21" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c13" target="fe-render-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c22" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c14" target="fe-render-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c23" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c15" target="fe-render-c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c24" value='&lt;font style="font-size: 12px;"&gt;往復は ①② → ③④⑤ → ⑥⑦ の 3 回。JS を読み終えるまで画面は空。refresh はブラウザから BFF 経由なので、回転した Cookie は BFF の Set-Cookie でそのままブラウザに届く。&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="1640" height="50" as="geometry" /></mxCell>
        <mxCell id="fe-render-c25" value="&lt;b&gt;frontend-ssr（ssr: true）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1200" height="28" as="geometry" /></mxCell>
        <mxCell id="fe-render-c26" value="" style="rounded=0;html=1;fillColor=#eef4fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c27" value="&lt;b&gt;ブラウザ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="665" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c28" value="" style="rounded=0;html=1;fillColor=#f6f0fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c29" value="&lt;b&gt;Nuxt サーバ（Nitro）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="790" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c30" value="" style="rounded=0;html=1;fillColor=#fff4e6;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1640" height="125" as="geometry" /></mxCell>
        <mxCell id="fe-render-c31" value="&lt;b&gt;backend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="48" y="915" width="130" height="44" as="geometry" /></mxCell>
        <mxCell id="fe-render-c32" value='① /tasks を開く&lt;br&gt;&lt;font style="font-size: 10px;"&gt;refresh_token Cookie が同送される&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="637" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c33" value='② &lt;b&gt;auth-init.ts&lt;/b&gt;（サーバ実行）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;useAuth().refresh() は&lt;br&gt;BFF を通らず backend を直接&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="375" y="762" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c34" value='③ &lt;b&gt;POST /auth/refresh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;回転した新しい組&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="560" y="887" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c35" value='④ &lt;b&gt;useCookie&lt;/b&gt; で新しい refresh を書き戻す（Set-Cookie）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;useState に access&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="745" y="762" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c36" value="⑤ middleware を通過&lt;br&gt;&lt;b&gt;useAsyncData&lt;/b&gt;('tasks')&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;useApiClient はサーバ用 apiBaseUrl&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="930" y="762" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c37" value='⑥ &lt;b&gt;GET /tasks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;Nitro から Bearer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1115" y="887" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c38" value='⑦ 一覧入りの HTML を生成&lt;br&gt;&lt;font style="font-size: 10px;"&gt;useState はペイロードに載せる&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1300" y="762" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c39" value='⑧ &lt;b&gt;最初の HTML に一覧が入っている&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;ハイドレーション（再フェッチなし）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f9e44;strokeWidth=3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1485" y="637" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="fe-render-c40" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c32" target="fe-render-c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c41" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c33" target="fe-render-c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c42" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c34" target="fe-render-c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c43" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c35" target="fe-render-c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c44" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c36" target="fe-render-c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c45" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c37" target="fe-render-c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c46" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-render-c38" target="fe-render-c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-render-c47" value='&lt;font style="font-size: 12px;"&gt;ブラウザから見た往復は ①⑧ の 1 回だけ。&lt;b&gt;サーバ側の refresh が BFF を通らない理由&lt;/b&gt;：内部の $fetch で BFF を呼ぶと、BFF が付ける Set-Cookie がブラウザへの応答に載らず、回転後の refresh を取りこぼす。そのため useAuth が import.meta.server のときだけ backend を直接呼び、useCookie で自分で書き戻す。access は SSR ではペイロードにも載る（短命なので許容）。&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1640" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fe-confirm" name="4. 確認画面の方式差">
    <mxGraphModel dx="1720" dy="1270" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1270" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fe-confirm-c1" value='&lt;b&gt;確認画面の方式差（両版で実装を分けている唯一の画面）&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;両版とも /tasks/new（入力）→ /tasks/new/confirm（確認）の 2 ルート・画像はメモリ保持で揃え、&lt;b&gt;draft をどこに置くか&lt;/b&gt;の一点だけを変えている。data-testid は共通で、共通の E2E（task-flow.spec.ts）が両方で通る&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1640" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c2" value="&lt;b&gt;frontend-spa（CSR）：draft ＝ sessionStorage&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="790" height="28" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c3" value="① &lt;b&gt;/tasks/new&lt;/b&gt;：TaskForm を submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c4" value='② &lt;b&gt;useTaskDraft().save&lt;/b&gt;(value)&lt;br&gt;&lt;font style="font-size: 10px;"&gt;draft の JSON を sessionStorage へ。画像 File は useState（メモリ）へ退避&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="211" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c5" value="③ navigateTo('/tasks/new/confirm')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="307" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c6" value='④ &lt;b&gt;confirm.vue&lt;/b&gt;：load() で同期的に復元し、&lt;b&gt;クライアントで描画&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;taskDraftSchema で検証。壊れた JSON・契約外の status は draft なし → /tasks/new へ戻す&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="383" width="520" height="80" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c7" value='⑤ 「作成する」→ &lt;b&gt;POST /tasks&lt;/b&gt; → 画像があれば &lt;b&gt;POST /tasks/{id}/image&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;→ clear() で draft を破棄 → 詳細へ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="489" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c8" value='⑥ 422 のとき&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;draftErrors にフィールド別のエラーを入れて /tasks/new に戻す（入力値は draft から復元）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="520" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c9" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c3" target="fe-confirm-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c10" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c4" target="fe-confirm-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c11" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c5" target="fe-confirm-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c12" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c6" target="fe-confirm-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c13" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c7" target="fe-confirm-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c14" value='&lt;b&gt;sessionStorage&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;タブ単位・JS から読める&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="211" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c15" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c4" target="fe-confirm-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c16" value='&lt;b&gt;useState&lt;/b&gt;（メモリ）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;画像 File → createObjectURL でプレビュー&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="383" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c17" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c6" target="fe-confirm-c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c18" value="&lt;b&gt;frontend-ssr（SSR）：draft ＝ httpOnly Cookie&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="95" width="790" height="28" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c19" value='① &lt;b&gt;/tasks/new&lt;/b&gt;：TaskForm を submit&lt;br&gt;&lt;font style="font-size: 10px;"&gt;payloadByteLimit で入力中に Cookie 上限を警告&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="135" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c20" value='② &lt;b&gt;POST /api/tasks/draft&lt;/b&gt; → Nitro（draft.post.ts）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;taskDraftSchema で形式検証（400）・3,500 バイト超は 413 → Cookie task_draft に保存（backend へは中継しない）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="211" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c21" value="③ navigateTo('/tasks/new/confirm')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="307" width="520" height="50" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c22" value='④ &lt;b&gt;confirm.vue&lt;/b&gt;：useAsyncData ＋ &lt;b&gt;useRequestFetch&lt;/b&gt;() で GET /api/tasks/draft を&lt;b&gt;サーバ実行&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;確認内容入りの HTML を返す。$fetch だと元リクエストの Cookie が Nitro に届かない&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="383" width="520" height="80" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c23" value='⑤ 「作成する」→ &lt;b&gt;POST /tasks&lt;/b&gt; → 画像があれば &lt;b&gt;POST /tasks/{id}/image&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;→ DELETE /api/tasks/draft で破棄 → 詳細へ&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="489" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c24" value='⑥ 422 のとき&lt;br&gt;&lt;font style="font-size: 10px; color: #d6336c;"&gt;SPA と同じ（draftErrors → /tasks/new。入力値は Cookie から復元）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="585" width="520" height="60" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c25" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c19" target="fe-confirm-c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c26" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c20" target="fe-confirm-c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c27" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c21" target="fe-confirm-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c28" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c22" target="fe-confirm-c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c29" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;strokeColor=#333333;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c23" target="fe-confirm-c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c30" value='&lt;b&gt;Cookie task_draft&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px;"&gt;httpOnly・30 分で失効・タブ間で共有&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="211" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c31" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c20" target="fe-confirm-c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c32" value='&lt;b&gt;useState&lt;/b&gt;（メモリ）&lt;br&gt;&lt;font style="font-size: 10px;"&gt;画像 File。&amp;lt;ClientOnly&amp;gt; でプレビュー&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="383" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c33" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;endArrow=open;endSize=10;dashed=1;dashPattern=2 3;strokeColor=#777777;fontColor=#555555;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-confirm-c22" target="fe-confirm-c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="fe-confirm-c34" value='&lt;b&gt;どちらが優れているかではなく、制約が入れ替わる&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 12px; border-collapse: collapse;" border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;frontend-spa（sessionStorage）&lt;/th&gt;&lt;th&gt;frontend-ssr（httpOnly Cookie）&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;確認内容の描画&lt;/td&gt;&lt;td&gt;ハイドレーション後にクライアントが描画&lt;/td&gt;&lt;td&gt;初回 HTML にサーバが埋め込む（JS 無しでも読める）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;リロード&lt;/td&gt;&lt;td&gt;残る&lt;/td&gt;&lt;td&gt;残る&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;別タブで確認画面を開く&lt;/td&gt;&lt;td&gt;&lt;b&gt;draft が無く入力画面へ戻る&lt;/b&gt;（タブ単位）&lt;/td&gt;&lt;td&gt;&lt;b&gt;復元できる&lt;/b&gt;（Cookie はタブ間で共有）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;サイズ上限&lt;/td&gt;&lt;td&gt;実質なし（約 5MB）&lt;/td&gt;&lt;td&gt;&lt;b&gt;3,500 バイト&lt;/b&gt;（日本語で約 380 文字。URL エンコード後の長さで判定）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;XSS 耐性&lt;/td&gt;&lt;td&gt;&lt;b&gt;JS から読める&lt;/b&gt;（XSS で入力内容が漏れうる）&lt;/td&gt;&lt;td&gt;httpOnly なので JS から読めない&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;画像&lt;/td&gt;&lt;td colspan="2"&gt;両版とも useState の File（保存できないため、リロードすると消える）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;Cookie 方式はサイズ上限と引き換えに XSS 耐性とタブ間共有を得て、sessionStorage 方式はサイズの自由と引き換えにその両方を失う。Cookie は 1 本約 4KB を超えると&lt;b&gt;エラーにならず黙って破棄&lt;/b&gt;されるため、413 を最終防御として残している。上限を無くすなら、Nitro のサーバ側ストア ＋ Cookie にはセッション ID だけ、という方式に移す（未着手）。&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1640" height="340" as="geometry" /></mxCell>
        <mxCell id="fe-confirm-c35" value='&lt;b&gt;E2E の分け方&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style="font-size: 12px; border-collapse: collapse;" border="1" cellpadding="6"&gt;&lt;tr&gt;&lt;th&gt;spec&lt;/th&gt;&lt;th&gt;対象&lt;/th&gt;&lt;th&gt;確かめること&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tests/e2e/task-flow.spec.ts&lt;/td&gt;&lt;td&gt;両版（共通）&lt;/td&gt;&lt;td&gt;入力 → 確認 → 作成の業務フロー。data-testid を揃えているので同じシナリオが通る&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tests/e2e/csr-confirm.spec.ts&lt;/td&gt;&lt;td&gt;frontend-spa&lt;/td&gt;&lt;td&gt;sessionStorage 方式の差（タブ単位など）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;tests/e2e/ssr-confirm.spec.ts&lt;/td&gt;&lt;td&gt;frontend-ssr&lt;/td&gt;&lt;td&gt;Cookie 方式の差（サーバ描画・上限など）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style="font-size: 12px;"&gt;E2E は dev サーバではなく本番ビルドを起動して検証する（出荷する成果物そのものを確かめるため）&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="1640" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
