<mxfile host="drawio" agent="Claude Code">
  <diagram id="overall-architecture" name="全体アーキテクチャ">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- タイトル -->
        <mxCell id="title" value="&lt;b&gt;全体アーキテクチャ構成図 — nuxtjs-nestjs-arch-practice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;同一の API 契約を 3 つのバックエンド（layered / clean / onion）で、同一機能を 2 つのフロントエンド（SPA / SSR）で実装し、比較する&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1200" height="50" as="geometry" />
        </mxCell>

        <!-- ============ Client ============ -->
